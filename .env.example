# Local development API. Vercel production must use /api so requests are proxied
# through the same public origin by api/[...path].js.
VITE_API_BASE_URL=http://localhost:3000/api

# Set only in the Vercel environment dashboard; it is read by the proxy function,
# not bundled into the browser application.
API_ORIGIN=https://your-railway-service.up.railway.app
